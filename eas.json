{
  "cli": {
    "version": ">= 7.0.0",
    "appVersionSource": "remote"
  },
  "build": {
    "development": {
      "developmentClient": true,
      "distribution": "internal",
      "env": {
        "EXPO_PUBLIC_ATTRIBUTION_TEST": "true",
        "EXPO_PUBLIC_META_APP_EVENTS_ENABLED": "false"
      }
    },
    "preview": {
      "distribution": "internal",
      "env": {
        "EXPO_PUBLIC_BACKEND_URL": "https://api.sanctuaryapp.us",
        "EXPO_PUBLIC_ATTRIBUTION_TEST": "true",
        "EXPO_PUBLIC_META_APP_EVENTS_ENABLED": "false"
      }
    },
    "device-qa": {
      "extends": "production",
      "distribution": "internal",
      "autoIncrement": false,
      "env": {
        "ORG_GRADLE_PROJECT_reactNativeArchitectures": "arm64-v8a",
        "EXPO_PUBLIC_ATTRIBUTION_TEST": "true",
        "EXPO_PUBLIC_META_APP_EVENTS_ENABLED": "false"
      },
      "android": {
        "buildType": "apk"
      }
    },
    "production": {
      "autoIncrement": true,
      "android": {
        "buildType": "app-bundle"
      },
      "env": {
        "EXPO_PUBLIC_BACKEND_URL": "https://api.sanctuaryapp.us",
        "EXPO_PUBLIC_ATTRIBUTION_TEST": "false"
      },
      "environment": "production"
    }
  },
  "submit": {
    "production": {
      "ios": {
        "ascAppId": "6757966099"
      },
      "android": {
        "track": "production",
        "releaseStatus": "completed"
      }
    },
    "internal": {
      "android": {
        "track": "internal",
        "releaseStatus": "completed",
        "changesNotSentForReview": true
      }
    },
    "open-testing": {
      "android": {
        "track": "beta",
        "releaseStatus": "completed"
      }
    },
    "store-review": {
      "extends": "production",
      "android": {
        "track": "production",
        "releaseStatus": "draft",
        "changesNotSentForReview": true
      }
    }
  }
}
