# Supabase public project configuration (never use a service-role key)
EXPO_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=your_public_anon_key

EXPO_PUBLIC_REVENUECAT_APPLE_KEY=appl_your_revenuecat_apple_key
EXPO_PUBLIC_REVENUECAT_GOOGLE_KEY=goog_your_revenuecat_google_key

# Google Sign-In - Get from Google Cloud Console
# Web client ID (OAuth 2.0 - Web application)
EXPO_PUBLIC_GOOGLE_WEB_CLIENT_ID=your_web_client_id.apps.googleusercontent.com
# iOS client ID (OAuth 2.0 - iOS)
EXPO_PUBLIC_GOOGLE_IOS_CLIENT_ID=your_ios_client_id.apps.googleusercontent.com

# For Android DEVELOPER_ERROR, ensure:
# 1. Android client ID is registered in Google Cloud (OAuth 2.0 - Android)
# 2. Your signing certificate SHA-1 fingerprint matches Google Cloud config
#    Get it: cd android && ./gradlew signingReport | grep SHA-1
# 3. Package name (us.sanctuaryapp.app) matches Google Cloud credentials
# 4. Rebuild the app bundle with new credentials

# First-party acquisition endpoint. No service credentials belong in the app.
EXPO_PUBLIC_ATTRIBUTION_URL=https://www.sanctuaryapp.us
# Set to the publication instant for the first tracking-enabled binary.
EXPO_PUBLIC_ATTRIBUTION_RELEASE_AT=
# Internal distribution must keep synthetic installs out of campaign totals.
EXPO_PUBLIC_ATTRIBUTION_TEST=true

# Meta's mobile SDK uses a CLIENT token, never the Meta app secret.
# The registered Sanctuary Meta App ID is 1153789907089705.
META_APP_ID=1153789907089705
META_APP_CLIENT_TOKEN=
# Keep false for QA; enable in the reviewed production release environment.
EXPO_PUBLIC_META_APP_EVENTS_ENABLED=false
